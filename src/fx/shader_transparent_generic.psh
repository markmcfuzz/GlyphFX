// ----------------------------------------------------------------------------
// GlyphFX | fx/shader_transparent_generic.psh
//
// Pixel shader for shader_transparent_generic.
// Ported from ringworld's shader_transparent_generic.hlsl - the modern
// reimplementation of the NV register combiners the original game used.
// The game compiles one pixel shader per tag with the stage configuration
// baked in; here the same math runs over the material parameters instead.
//
// ── IMPLEMENTATION NOTE ──────────────────────────────────────────────────────
// The combiner registers live in one indexable array (`regs`) and every
// enum-driven decision (input select, input/output mapping, output routing)
// is a table lookup instead of an if/else chain.  With 8 input selects × 25
// options × 7 stages × 4 entry points, if/else chains take the D3D compiler
// ~50 seconds to flatten; the table-driven form compiles in well under a
// second with identical results.  Do not "simplify" this back into branches.
//
// ── COMBINER PIPELINE ────────────────────────────────────────────────────────
// Up to 4 maps are sampled into map color 0-3, then up to 7 stages run in
// order.  Each stage selects four color inputs (A-D) and four alpha inputs,
// applies an input mapping to each, and combines them:
//     AB       = A op B      (op = multiply | dot product; alpha always ×)
//     CD       = C op D
//     Mux/Sum  = mux flag off:  AB + CD
//                mux flag on:   scratch alpha 0 >= 0.5 ? CD : AB
// The output mapping scales/biases all three results, then each is written
// to its selected register (Discard = don't write).  After the last stage,
// scratch color 0 / scratch alpha 0 hold the final color / alpha.
//
// Register file layout (slot = the order used by the INPUT enums):
//   0-3  map color/alpha 0-3     6-7  scratch color 0/1 (6 = final output)
//   4-5  vertex color 0/1        8-9  per-stage constant color 0/1
//   10   write-only dummy slot that absorbs "Discard" outputs
// Scratch 0 starts as (0, 0, 0, map 0 alpha).  Disabled maps read (0,0,0,0).
//
// Constant color 0 is animated in-engine between the lower and upper bounds:
//     color0 = lower + f * (upper - lower)
// f comes from the vertex shader (Color0AnimationValue).  With Animation
// Preview on, it is the A Out slider when "A-Out Controls Color0 Animation"
// is set, else periodic(function, AnimationTime / period) (_periodic.fxh).
// With it off the viewport shows the tag's IDLE state:
//   - "A-Out Controls Color0 Animation" set: A-out is 0 until the external
//     event fires (e.g. the shield being hit), so the LOWER bound is used.
//   - wave function Zero: lower bound.
//   - anything else: the wave peak, i.e. the upper bound.
// "Color0 Source" 1-4 multiplies color0's RGB by `ChangeColorA`-`ChangeColorD`,
// the object's change colors A-D, filled by the toolkit (0 = no tint).
// The stage colors are ARGB: the RGB comes from the color widget, the A from
// the separate "Alpha (A of ARGB)" slider.
//
// ── FRAMEBUFFER FADE ─────────────────────────────────────────────────────────
// In-engine an extra combiner stage applies the Framebuffer Fade Mode; here
// the equivalent math runs in each blend function:
//   Alpha Blend       final alpha × fade
//   Add               final rgb × fade
//   Multiply          lerp(1.0, rgb, fade)   - fades to blend-neutral white
//   Double Multiply   lerp(0.5, rgb, fade)   - fades to blend-neutral grey
// Framebuffer Fade Source selects an external animation output and is
// informational only.
//
// ── FRAMEBUFFER BLEND MODES ──────────────────────────────────────────────────
// Nitrous ignores blend states.  Alpha Blend dithers by the final alpha and
// is exact.  Add / Multiply / Double Multiply use the coverage solve in
// _coverage.fxh (the shader_transparent_water scheme), tuned by the
// "Viewport Blend" parameters.  The Framebuffer Blend Function parameter
// picks the blend (PS_Main); Subtract, Component Min/Max and Alpha-Multiply
// Add draw as the closest of the four (ViewportBlendMode, _coverage.fxh).
// ----------------------------------------------------------------------------

// ─── Combiner register file ──────────────────────────────────────────────────

static float4 regs[11];

// Input selections 0-4 are the combiner constants.
static const float GX_KONST[5] = { 0.0, 1.0, 0.5, -1.0, -0.5 };

// ─── Input mapping ───────────────────────────────────────────────────────────
// 0=clamp(x)  1=1-clamp(x)  2=2*clamp(x)-1  3=1-2*clamp(x)
// 4=clamp(x)-1/2  5=1/2-clamp(x)  6=x  7=-x
// clamp(x) is the combiner's "unsigned" read: only negatives clamp to 0,
// except mapping 1 which uses a full [0,1] clamp (as in ringworld).
// Encoded as:  result = k.x*max(v,0) + k.y*saturate(v) + k.z*v + k.w
static const float4 GX_INPUT_MAP[8] =
{
    float4( 1.0,  0.0,  0.0,  0.0),   // 0: clamp(x)
    float4( 0.0, -1.0,  0.0,  1.0),   // 1: 1 - clamp(x)
    float4( 2.0,  0.0,  0.0, -1.0),   // 2: 2*clamp(x) - 1
    float4(-2.0,  0.0,  0.0,  1.0),   // 3: 1 - 2*clamp(x)
    float4( 1.0,  0.0,  0.0, -0.5),   // 4: clamp(x) - 1/2
    float4(-1.0,  0.0,  0.0,  0.5),   // 5: 1/2 - clamp(x)
    float4( 0.0,  0.0,  1.0,  0.0),   // 6: x
    float4( 0.0,  0.0, -1.0,  0.0)    // 7: -x
};

float3 ApplyInputMappingC(float3 v, int m)
{
    float4 k = GX_INPUT_MAP[clamp(m, 0, 7)];
    return k.x * max(v, 0.0) + k.y * saturate(v) + k.z * v + k.w;
}

float ApplyInputMappingA(float v, int m)
{
    float4 k = GX_INPUT_MAP[clamp(m, 0, 7)];
    return k.x * max(v, 0.0) + k.y * saturate(v) + k.z * v + k.w;
}

// ─── Input selection ─────────────────────────────────────────────────────────
// Color: 0=zero 1=one 2=1/2 3=-1 4=-1/2 5-8=map color 9/10=vertex color
// 11/12=scratch color 13/14=constant color 15-24=alpha of the same registers.
// Alpha: same order, but 5-14 read .a and 15-24 read .b (the "blue" inputs).

// One return each: with early returns the compiler warns, inside the stage
// loop, that the result may be uninitialized.
float3 SelectColorInput(int sel)
{
    sel = clamp(sel, 0, 24);
    float4 reg = regs[max(sel < 15 ? sel - 5 : sel - 15, 0)];
    float3 v   = sel < 15 ? reg.rgb : reg.aaa;
    return sel < 5 ? GX_KONST[min(sel, 4)].xxx : v;
}

float SelectAlphaInput(int sel)
{
    sel = clamp(sel, 0, 24);
    float4 reg = regs[max(sel < 15 ? sel - 5 : sel - 15, 0)];
    float  v   = sel < 15 ? reg.a : reg.b;
    return sel < 5 ? GX_KONST[min(sel, 4)] : v;
}

// ─── Output function / mapping / write ───────────────────────────────────────

// 0 = multiply (result clamped to [-1, 1] like the combiner)  1 = dot product
float3 CombineC(float3 x, float3 y, int f)
{
    return (f == 1) ? dot(x, y).xxx : clamp(x * y, -1.0, 1.0);
}

// The alpha pipeline always multiplies.
float CombineA(float x, float y)
{
    return clamp(x * y, -1.0, 1.0);
}

// 0=identity 1=scale by 1/2 2=scale by 2 3=scale by 4 4=bias by -1/2
// 5=expand normal ((x - 1/2) * 2).  Encoded as:  result = k.x*v + k.y
static const float2 GX_OUTPUT_MAP[6] =
{
    float2(1.0,  0.0),
    float2(0.5,  0.0),
    float2(2.0,  0.0),
    float2(4.0,  0.0),
    float2(1.0, -0.5),
    float2(2.0, -1.0)
};

float3 ApplyOutputMappingC(float3 v, int m)
{
    float2 k = GX_OUTPUT_MAP[clamp(m, 0, 5)];
    return k.x * v + k.y;
}

float ApplyOutputMappingA(float v, int m)
{
    float2 k = GX_OUTPUT_MAP[clamp(m, 0, 5)];
    return k.x * v + k.y;
}

// Output enum (0=discard 1=scratch 0 2=scratch 1 3=vertex 0 4=vertex 1
// 5-8=map 0-3) -> register file slot.  Discard routes to the dummy slot.
static const int GX_OUT_SLOT[9] = { 10, 6, 7, 4, 5, 0, 1, 2, 3 };

// Combiner registers hold [-1, 1] on the real hardware (Xbox NV2A and PC
// ps_1_x), so a "scale by 2/4" output saturates there.  ringworld skips this
// clamp; without it a later stage can read a value above 1.
void WriteColorOutput(float3 v, int o)
{
    regs[GX_OUT_SLOT[clamp(o, 0, 8)]].rgb = clamp(v, -1.0, 1.0);
}

void WriteAlphaOutput(float v, int o)
{
    regs[GX_OUT_SLOT[clamp(o, 0, 8)]].a = clamp(v, -1.0, 1.0);
}

// ─── Stage evaluation ────────────────────────────────────────────────────────
// Mirrors ringworld's STAGE macro exactly: all inputs and both mux decisions
// read the register values from BEFORE this stage's writes; the six writes
// happen together at the end (later writes to the same register win).
//
// The stages run in a real loop, so the compiler emits RunStage once.  Calling
// it once per stage unrolled seven copies and made each pixel shader take ~1 s
// to compile (~4 s for Max's first load of the effect).  Each iteration loads
// its stage with LoadStage: a chain of branches on the stage index.  Copying
// all stages into a local array and indexing it costs twice the compile time.
// Do not unroll it back.

struct GxStage
{
    int    enabled;
    float4 lower;          // constant color 0 animation bounds (ARGB as RGBA)
    float4 upper;
    float4 color1;         // constant color 1
    float  color0Anim;     // color0 animation value, from the vertex shader
    int    color0Source;
    int    mux;            // bit 0 = color mux, bit 1 = alpha mux
    int4   colorIn;        // color inputs A-D
    int4   colorMap;       // and their mappings
    int2   colorFunc;      // AB / CD function
    int4   colorOut;       // AB, CD, AB CD mux/sum outputs, output mapping
    int4   alphaIn;        // alpha inputs A-D
    int4   alphaMap;       // and their mappings
    int4   alphaOut;       // AB, CD, AB CD mux/sum outputs, output mapping
};

void RunStage(GxStage st)
{
    // Constant color 0: the engine animates lower -> upper by the stage's
    // animation value (see Color0AnimationValue in the vertex shader).
    regs[8] = saturate(st.lower + st.color0Anim * (st.upper - st.lower));
    // Color0 Source 1-4: tint by the object's change color A-D (RGB only).
    // Any other value leaves it untinted, as in the engine.
    if (st.color0Source == 1) regs[8].rgb *= ChangeColorA.rgb;
    if (st.color0Source == 2) regs[8].rgb *= ChangeColorB.rgb;
    if (st.color0Source == 3) regs[8].rgb *= ChangeColorC.rgb;
    if (st.color0Source == 4) regs[8].rgb *= ChangeColorD.rgb;
    regs[9] = st.color1;

    float3 cin[4];
    float  ain[4];
    [loop] for (int j = 0; j < 4; j++)
    {
        cin[j] = ApplyInputMappingC(SelectColorInput(st.colorIn[j]), st.colorMap[j]);
        ain[j] = ApplyInputMappingA(SelectAlphaInput(st.alphaIn[j]), st.alphaMap[j]);
    }
    float3 a = cin[0], b = cin[1], c = cin[2], d = cin[3];

    float3 ab     = CombineC(a, b, st.colorFunc.x);
    float3 cd     = CombineC(c, d, st.colorFunc.y);
    float3 muxSum = (st.mux & 1) ? (regs[6].a >= 0.5 ? cd : ab) : ab + cd;
    muxSum = clamp(muxSum, -1.0, 1.0);

    ab     = ApplyOutputMappingC(ab,     st.colorOut.w);
    cd     = ApplyOutputMappingC(cd,     st.colorOut.w);
    muxSum = ApplyOutputMappingC(muxSum, st.colorOut.w);

    float aA = ain[0], aB = ain[1], aC = ain[2], aD = ain[3];

    float abA     = CombineA(aA, aB);
    float cdA     = CombineA(aC, aD);
    float muxSumA = (st.mux & 2) ? (regs[6].a >= 0.5 ? cdA : abA) : abA + cdA;
    muxSumA = clamp(muxSumA, -1.0, 1.0);

    abA     = ApplyOutputMappingA(abA,     st.alphaOut.w);
    cdA     = ApplyOutputMappingA(cdA,     st.alphaOut.w);
    muxSumA = ApplyOutputMappingA(muxSumA, st.alphaOut.w);

    WriteColorOutput(ab,     st.colorOut.x);
    WriteColorOutput(cd,     st.colorOut.y);
    WriteColorOutput(muxSum, st.colorOut.z);
    WriteAlphaOutput(abA,     st.alphaOut.x);
    WriteAlphaOutput(cdA,     st.alphaOut.y);
    WriteAlphaOutput(muxSumA, st.alphaOut.z);
}

// Copies stage N's material parameters into the record `s`.  The ARGB colors
// are composed from the RGB color widget + the separate alpha slider.  F is
// the stage's color0 animation value from the vertex shader.
#define GX_STAGE_DATA(N, ENABLED, F)                                       \
    s.enabled      = (ENABLED) ? 1 : 0;                                    \
    s.lower        = float4(Stage##N##_Color0AnimationLowerBound.rgb,      \
                                Stage##N##_Color0LowerAlpha);                  \
    s.upper        = float4(Stage##N##_Color0AnimationUpperBound.rgb,      \
                                Stage##N##_Color0UpperAlpha);                  \
    s.color1       = float4(Stage##N##_Color1.rgb, Stage##N##_Color1Alpha);\
    s.color0Anim   = (F);                                                  \
    s.color0Source = Stage##N##_Color0Source;                              \
    s.mux          = (Stage##N##_ColorMux ? 1 : 0) |                       \
                         (Stage##N##_AlphaMux ? 2 : 0);                        \
    s.colorIn      = int4(Stage##N##_ColorInputA, Stage##N##_ColorInputB,  \
                              Stage##N##_ColorInputC, Stage##N##_ColorInputD); \
    s.colorMap     = int4(Stage##N##_ColorInputAMapping,                   \
                              Stage##N##_ColorInputBMapping,                   \
                              Stage##N##_ColorInputCMapping,                   \
                              Stage##N##_ColorInputDMapping);                  \
    s.colorFunc    = int2(Stage##N##_ColorOutputABFunction,                \
                              Stage##N##_ColorOutputCDFunction);               \
    s.colorOut     = int4(Stage##N##_ColorOutputAB, Stage##N##_ColorOutputCD,\
                              Stage##N##_ColorOutputABCDMuxSum,                \
                              Stage##N##_ColorOutputMapping);                  \
    s.alphaIn      = int4(Stage##N##_AlphaInputA, Stage##N##_AlphaInputB,  \
                              Stage##N##_AlphaInputC, Stage##N##_AlphaInputD); \
    s.alphaMap     = int4(Stage##N##_AlphaInputAMapping,                   \
                              Stage##N##_AlphaInputBMapping,                   \
                              Stage##N##_AlphaInputCMapping,                   \
                              Stage##N##_AlphaInputDMapping);                  \
    s.alphaOut     = int4(Stage##N##_AlphaOutputAB, Stage##N##_AlphaOutputCD,\
                              Stage##N##_AlphaOutputABCDMuxSum,                \
                              Stage##N##_AlphaOutputMapping);

// ─── Map sampling ────────────────────────────────────────────────────────────

float4 SampleMap(Texture2D tex, float2 uv,
                 bool uClamped, bool vClamped, bool unfiltered, float mipBias)
{
    if (uClamped) uv.x = saturate(uv.x);
    if (vClamped) uv.y = saturate(uv.y);
    return unfiltered ? tex.SampleBias(smpPoint, uv, mipBias)
                      : tex.SampleBias(smpWrap,  uv, mipBias);
}

// With the Numeric flag set, Map 1 is the ammo counter's digit plate rather
// than a plain texture: the engine would bind one bitmap of the map's sequence
// per counter digit, the viewport crops the requested cell out of the plate
// the sequence was sliced from.  The crop confines the lookup to a single cell,
// so Map 1's U/V clamp flags stop mattering from here on.
float2 NumericMap1UV(float2 uv)
{
    [branch]
    if (Numeric)
    {
        // Plate size, either typed in or read off the bound texture.  Max does
        // not always report a texture's dimensions to the effect, and there is
        // no way to tell from inside the shader, so the manual values win when
        // they are set and 0 falls back to asking the texture.
        float tw = NumericPlateWidth;
        float th = NumericPlateHeight;
        if (tw < 1.0 || th < 1.0)
        {
            float aw, ah;
            Map1Texture.GetDimensions(aw, ah);
            tw = aw;
            th = ah;
        }
        uv = NumericPlateUV(uv, float2(tw, th), NumericDigit, NumericPlateLayout,
                            NumericPlateMargin, NumericPlateSeparator,
                            NumericPlateSideMargin, NumericPlateEdgeInset);
    }
    return uv;
}

// Stage k's record (k = 0 is stage 1, always active).
GxStage LoadStage(int k, STG_PS_INPUT i)
{
    GxStage s = (GxStage)0;
    [branch] if (k == 0) { GX_STAGE_DATA(1, true, i.color0Anim0.x) }
#if GX_GENERIC_STAGES >= 2
    [branch] if (k == 1) { GX_STAGE_DATA(2, EnableStage2, i.color0Anim0.y) }
#endif
#if GX_GENERIC_STAGES >= 3
    [branch] if (k == 2) { GX_STAGE_DATA(3, EnableStage3, i.color0Anim0.z) }
#endif
#if GX_GENERIC_STAGES >= 4
    [branch] if (k == 3) { GX_STAGE_DATA(4, EnableStage4, i.color0Anim0.w) }
#endif
#if GX_GENERIC_STAGES >= 5
    [branch] if (k == 4) { GX_STAGE_DATA(5, EnableStage5, i.color0Anim1.x) }
#endif
#if GX_GENERIC_STAGES >= 6
    [branch] if (k == 5) { GX_STAGE_DATA(6, EnableStage6, i.color0Anim1.y) }
#endif
#if GX_GENERIC_STAGES >= 7
    [branch] if (k == 6) { GX_STAGE_DATA(7, EnableStage7, i.color0Anim1.z) }
#endif
    return s;
}

// ─── Combiner pipeline ───────────────────────────────────────────────────────
// Samples the active maps and runs the active stages.  Returns the final
// color/alpha from scratch register 0.

float4 PS_Evaluate(STG_PS_INPUT i)
{
    // Map 1's clamp flags apply to the mesh UV, before the numeric crop remaps
    // it into a digit cell, so they are applied here and SampleMap gets a UV
    // that already has them baked in.
    float2 uv0 = i.uv0;
    if (Map1_UClamped) uv0.x = saturate(uv0.x);
    if (Map1_VClamped) uv0.y = saturate(uv0.y);

    regs[0] = SampleMap(Map1Texture, NumericMap1UV(uv0), false, false,
                        Map1_Unfiltered, Map1_MipmapBias);
    regs[1] = EnableMap2 ? SampleMap(Map2Texture, i.uv1, Map2_UClamped, Map2_VClamped,
                                     Map2_Unfiltered, Map2_MipmapBias)
                         : float4(0.0, 0.0, 0.0, 0.0);
    regs[2] = EnableMap3 ? SampleMap(Map3Texture, i.uv2, Map3_UClamped, Map3_VClamped,
                                     Map3_Unfiltered, Map3_MipmapBias)
                         : float4(0.0, 0.0, 0.0, 0.0);
    regs[3] = EnableMap4 ? SampleMap(Map4Texture, i.uv3, Map4_UClamped, Map4_VClamped,
                                     Map4_Unfiltered, Map4_MipmapBias)
                         : float4(0.0, 0.0, 0.0, 0.0);

    regs[4]  = i.vColor0;
    regs[5]  = i.vColor1;
    regs[6]  = float4(0.0, 0.0, 0.0, regs[0].a);
    regs[7]  = float4(0.0, 0.0, 0.0, 0.0);
    regs[8]  = float4(0.0, 0.0, 0.0, 0.0);
    regs[9]  = float4(0.0, 0.0, 0.0, 0.0);
    regs[10] = float4(0.0, 0.0, 0.0, 0.0);

    [loop] for (int k = 0; k < GX_GENERIC_STAGES; k++)
    {
        GxStage s = LoadStage(k, i);
        [branch] if (s.enabled != 0) RunStage(s);
    }

    return float4(saturate(regs[6].rgb), saturate(regs[6].a));
}

// ─── Framebuffer fade ────────────────────────────────────────────────────────
// 0=None  1=Fade When Perpendicular (vertex alpha 1)  2=Fade When Parallel
// (vertex blue 1).  In-engine this is an extra combiner stage; here the
// entry points apply it directly.

float FramebufferFade(STG_PS_INPUT i)
{
    if (FramebufferFadeMode == 1) return saturate(i.vColor1.a);
    if (FramebufferFadeMode == 2) return saturate(i.vColor1.b);
    return 1.0;
}

// ─── Opacity helpers (same as shader_transparent_chicago) ───────────────────

// Applies contrast (centred at 0.5), bias and gamma to a raw opacity value.
float ApplyOpacityControls(float raw)
{
    float o = saturate((raw - 0.5) * OpacityContrast + 0.5);
    o = saturate(o + OpacityBias);
    o = pow(o, 1.0 / max(OpacityGamma, 0.001));
    return o;
}

// Stochastic (dithered) discard using a screen-space hash.
// Ensures near-transparent fragments don't write to the depth buffer, which
// is required because DepthWriteMask = ALL is a Nitrous constraint.
// Fragments with alpha == 0 always discard; alpha == 1 always survive.
void DitherClip(float alpha, float4 clipPos)
{
    float2 screenUV = clipPos.xy / clipPos.w;
    float  dither   = frac(sin(dot(screenUV, float2(12.9898, 78.233))) * 43758.5453);
    clip(alpha - dither * DitherScale);
}

// ─── Framebuffer blends ───────────────────────────────────────────────

// Alpha Blend - uses the combiner's final alpha for opacity.
// Textures WITHOUT an alpha channel: 3ds Max fills t.a = 1.0, so c.a == 1.0.
//   → PS outputs alpha = 0.0 → Nitrous Standard/High Quality composites the
//     RGB output over the dark viewport background → black areas stay black.
// Textures WITH an alpha channel: c.a < 1.0 on transparent pixels.
//   → Opacity controls + dither clip for smooth transparency.
float4 BlendAlphaBlend(float4 c, STG_PS_INPUT i)
{
    c.a *= FramebufferFade(i);
    if (c.a >= 1.0)
        return float4(c.rgb, 0.0);
    float alpha = ApplyOpacityControls(c.a);
    DitherClip(alpha, i.clipPos);
    return float4(c.rgb, alpha);
}

// Add, Multiply and Double Multiply express the engine blend as
// background * Cmul + Cadd and let the coverage solve in _coverage.fxh realise
// it.  The old approach (draw the colour opaque, luminance as coverage) lost
// most of a dim additive effect: a colour of 0.2 only showed on 20% of the
// pixels and REPLACED the background there instead of adding to it.
float4 ResolveViewportBlend(float3 Cmul, float3 Cadd, float4 clipPos)
{
    BlendCoverage b = ResolveBlendCoverage(Cmul, Cadd, BackgroundBrightness,
                                           DitherAmount, MaxOpacity, ColorSaturation);
    clip(b.coverage - CoverageThreshold(clipPos));
    return float4(b.color, 1.0);
}

// Add - background + color.  Brightness is a viewport gain on the added color.
float4 BlendAdd(float4 c, STG_PS_INPUT i)
{
    float3 add = c.rgb * FramebufferFade(i) * Brightness;
    return ResolveViewportBlend((float3)1.0, add, i.clipPos);
}

// Multiply - background * color.  The fade pulls the color toward white, the
// blend-neutral value.
float4 BlendMultiply(float4 c, STG_PS_INPUT i)
{
    float3 mul = lerp((float3)1.0, c.rgb, FramebufferFade(i));
    return ResolveViewportBlend(mul, (float3)0.0, i.clipPos);
}

// Double Multiply - background * color * 2.  The fade pulls the color toward
// mid grey, the blend-neutral value.
float4 BlendDoubleMultiply(float4 c, STG_PS_INPUT i)
{
    float3 mul = 2.0 * lerp((float3)0.5, c.rgb, FramebufferFade(i));
    return ResolveViewportBlend(mul, (float3)0.0, i.clipPos);
}

// ─── Pixel shader ────────────────────────────────────────────────────────────
// One pixel shader for every blend: the tag's Framebuffer Blend Function picks
// it (ViewportBlendMode, _coverage.fxh), so the viewport matches the exported
// tag.  One shader instead of one per technique also compiles four times
// faster, i.e. Max's first load of the effect.

float4 PS_Main(STG_PS_INPUT i) : SV_TARGET
{
    float4 c    = PS_Evaluate(i);
    int    mode = ViewportBlendMode(FramebufferBlendFunction);
    [branch] if (mode == 1) return BlendMultiply(c, i);
    [branch] if (mode == 2) return BlendDoubleMultiply(c, i);
    [branch] if (mode == 3) return BlendAdd(c, i);
    return BlendAlphaBlend(c, i);
}
